<?xml version="1.0" encoding="utf-8"?>
<!-- Arrangement 1: number in the centre, days done under it, dates at the bottom. Generated shape: the three widget layouts share the same view ids (see CounterWidget.views). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/card_shape"
        android:tint="@color/green" />

    <ImageView
        android:id="@+id/shade"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/card_shade" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/row_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="@string/app_title"
                android:textColor="@color/on_card_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/st_inside"
                android:textColor="@color/on_card"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row_number"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/remaining"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="900"
                android:textColor="@color/on_card"
                android:textSize="50dp" />

            <TextView
                android:id="@+id/left_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="8dp"
                android:text="@string/days_left"
                android:textColor="@color/on_card_soft"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/done_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="0 / 900"
                android:textColor="@color/on_card"
                android:textDirection="ltr"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/done_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="6dp"
                android:text="@string/days_done"
                android:textColor="@color/on_card_soft"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/bar_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="900"
                android:progress="0"
                android:progressDrawable="@drawable/progress" />

            <ProgressBar
                android:id="@+id/progress_dark"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="900"
                android:progress="0"
                android:progressDrawable="@drawable/progress_dark"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/date_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/lbl_expected"
                android:textColor="@color/on_card_soft"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/date_g"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_card"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/date_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/on_card"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
